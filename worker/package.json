{
  "name": "linkcard-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create linkcard",
    "db:migrate:local": "wrangler d1 execute linkcard --local --file=./migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute linkcard --remote --file=./migrations/0001_initial.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.5.3",
    "wrangler": "^3.78.0"
  }
}
